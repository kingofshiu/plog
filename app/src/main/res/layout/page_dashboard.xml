<?xml version="1.0" encoding="utf-8"?>
<!-- 주행 탭 v14 (2026-09-15, 사용자: "더 센스 있게 → 다 해보자"): 테슬라 에너지 앱 · 폴스타 순정 화면을 참고한 "박스 없는" 타이포 레이아웃.
     상단 = 상태 한 줄 + 오늘 요약 / 히어로 = 배터리(왼쪽) | 세로 헤어라인 | 속도·이번 주행·전비 (주차 중엔 마지막 주행·전비·평소 대비)
     하단 = 상황에 따라 바뀐다 (v14):
       주행 중: 실시간 전력 게이지 | 충전 사이클 | 지금 달리는 경로 라이브 지도
       주차 중: 이번 주·이번 달 요약  | 충전 사이클 | 오늘 타임라인 + 주행 기록 표
     테두리·타일 없음, 헤어라인만. 스크롤 없음 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/dash_warn_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="차량 데이터 확인 필요"
        android:textSize="@dimen/text_label"
        android:textColor="@color/red"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- ===== 상태 한 줄 + 오늘 요약 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- 시계 (2026-09-15 추가): 히어로 오른쪽 위 → 배터리 위 → 2026-09-21 상태 줄 맨 왼쪽(사용자 두 번 "별로").
             차량 계기판 상태 바처럼 시각이 맨 앞, 세로 공간을 안 먹고 배터리 칸을 건드리지 않는다 -->
        <TextView
            android:id="@+id/dash_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/dash_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="@dimen/text_label"
            android:textColor="#8E8E93"
            android:includeFontPadding="false"
            android:layout_marginStart="12dp" />
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#3A3A3E"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />
        <View
            android:id="@+id/dash_state_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="10dp" />
        <TextView
            android:id="@+id/dash_state_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="대기 중"
            android:textSize="@dimen/text_label"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_sub"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView style="@style/HdLabel" android:text="오늘 주행" />
        <TextView android:id="@+id/dash_today" style="@style/HdValue" />
        <TextView style="@style/HdLabel" android:text="오늘 전비" android:layout_marginStart="28dp" />
        <TextView android:id="@+id/dash_eff" style="@style/HdValue" />
        <TextView android:id="@+id/dash_total_label" style="@style/HdLabel" android:text="누적" android:layout_marginStart="28dp" />
        <TextView android:id="@+id/dash_total" style="@style/HdValue" />
    </LinearLayout>

    <!-- ===== 히어로: 배터리 | 속도 · 이번 주행 · 이번 주행 전비 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dash_soc_caption"
                style="@style/HeroLabel"
                android:text="배터리"
                android:drawableStart="@drawable/ic_st_battery" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/dash_soc_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="@dimen/text_display"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="@dimen/text_value_m"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false"
                    android:paddingBottom="10dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <!-- 배터리 라인: 충전 중이면 초록 + 흐르는 빛 띠 (SocBarView, 2026-09-08) -->
            <com.p4log.car.SocBarView
                android:id="@+id/dash_soc_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="14dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="12dp">
                <TextView style="@style/HdLabel" android:text="주행가능거리" android:textSize="@dimen/text_label" android:layout_marginEnd="10dp" android:drawableStart="@drawable/ic_st_range" android:drawablePadding="8dp" android:drawableTint="#8E8E93" android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/dash_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_m"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:background="#232326" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.9"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout style="@style/TdCell">
                <!-- 주행 중: 속도 · 이번 주행 · 이번 주행 전비 / 주차 중(최근 6시간 안에 주행이 있으면): 마지막 주행 · 전비 · 평소 대비 (2026-09-13) -->
                <TextView android:id="@+id/dash_hero1_label" style="@style/HeroLabel" android:text="속도" android:drawableStart="@drawable/ic_st_speed" />
                <TextView android:id="@+id/dash_speed" style="@style/HeroValue" />
            </LinearLayout>
            <LinearLayout style="@style/TdCell">
                <TextView android:id="@+id/dash_hero2_label" style="@style/HeroLabel" android:text="이번 주행" android:drawableStart="@drawable/ic_st_dist" />
                <TextView android:id="@+id/dash_trip_km" style="@style/HeroValue" />
            </LinearLayout>
            <LinearLayout style="@style/TdCell">
                <TextView android:id="@+id/dash_hero3_label" style="@style/HeroLabel" android:text="이번 주행 전비" android:drawableStart="@drawable/ic_st_eff" />
                <TextView android:id="@+id/dash_trip_eff" style="@style/HeroValue" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#232326"
        android:layout_marginBottom="12dp" />

    <!-- ===== 하단 3열 (v14): 상황별로 1열·3열 내용이 바뀐다 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 1열: 주행 중 = 실시간 전력 / 주차 중 = 이번 주·이번 달 요약 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85">
            <LinearLayout
                android:id="@+id/dash_col_power"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView android:id="@+id/dash_power_label" style="@style/HeroLabel" android:text="실시간 전력 · 소비" android:drawableStart="@drawable/ic_st_energy" />
                <TextView
                    android:id="@+id/dash_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_l"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/accent"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp" />
                <com.p4log.car.PowerMeterView
                    android:id="@+id/dash_power_chart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dash_col_week"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/HeroLabel" android:text="이번 주" android:drawableStart="@drawable/ic_st_log" />
                <TextView
                    android:id="@+id/dash_week_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_l"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/dash_week_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/dash_week_cmp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/green"
                    android:drawableStart="@drawable/ic_st_compare"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/green"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp" />
                <TextView style="@style/HeroLabel" android:text="이번 달" android:drawableStart="@drawable/ic_st_dist" android:layout_marginTop="26dp" />
                <TextView
                    android:id="@+id/dash_month_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_m"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/dash_month_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </FrameLayout>

        <Space android:layout_width="36dp" android:layout_height="1dp" />

        <!-- 2열: 충전 사이클 (2026-09-15 확장): 충전 이후 km · 배터리 사용 · 회생 비율 게이지 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:orientation="vertical">
            <TextView android:id="@+id/dash_cycle_title" style="@style/HeroLabel" android:text="충전 이후" android:drawableStart="@drawable/ic_st_station" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/dash_cycle_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_l"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/dash_cycle_sub"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_sub"
                    android:includeFontPadding="false"
                    android:paddingBottom="7dp"
                    android:layout_marginStart="14dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
            <!-- 회생 회수: 비율(초록) + kWh, 게이지에 평소 비율 선 (2026-09-08) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="14dp">
                <TextView style="@style/HdLabel" android:text="회생 회수" android:textSize="@dimen/text_body" android:drawableStart="@drawable/ic_st_regen" android:drawablePadding="8dp" android:drawableTint="#8E8E93" android:gravity="center_vertical" android:paddingBottom="4dp" />
                <TextView
                    android:id="@+id/dash_cycle_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_value_m"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/green"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="@dimen/text_label"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="3dp" />
                <TextView
                    android:id="@+id/dash_cycle_kwh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_sub"
                    android:includeFontPadding="false"
                    android:paddingBottom="5dp"
                    android:layout_marginStart="14dp" />
            </LinearLayout>
            <com.p4log.car.RatioMeterView
                android:id="@+id/dash_regen_chart"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="10dp">
                <TextView android:id="@+id/dash_regen_trip_label" style="@style/HdLabel" android:text="이번 주행" android:textSize="@dimen/text_body" android:paddingBottom="3dp" />
                <TextView android:id="@+id/dash_regen_trip" style="@style/HdValue" android:textSize="@dimen/text_title" android:textColor="@color/green" />
                <TextView style="@style/HdLabel" android:text="비율" android:textSize="@dimen/text_body" android:paddingBottom="3dp" android:layout_marginStart="20dp" />
                <TextView android:id="@+id/dash_regen_today" style="@style/HdValue" android:textSize="@dimen/text_title" android:textColor="@color/green" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="36dp" android:layout_height="1dp" />

        <!-- 3열: 주행 중 = 라이브 경로 지도 / 주차 중 = 오늘 타임라인 + 주행 기록 표 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5">
            <LinearLayout
                android:id="@+id/dash_col_table"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView style="@style/HeroLabel" android:text="오늘 · 주행 기록" android:drawableStart="@drawable/ic_st_log" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView
                        android:id="@+id/dash_all_trips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전체 기록"
                        android:textSize="@dimen/text_label"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_button_dim"
                        android:minHeight="54dp"
                        android:gravity="center"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                </LinearLayout>
                <!-- 오늘의 타임라인 (2026-09-15): 0~24시 선 위에 오늘 주행을 막대로 -->
                <com.p4log.car.DayTimelineView
                    android:id="@+id/dash_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/dash_recent_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아직 주행 기록이 없습니다 · 첫 주행이 끝나면 여기에 자동으로 쌓입니다"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_sub"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/dash_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp"
                    android:showDividers="middle"
                    android:divider="@drawable/divider_hairline" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dash_col_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/dash_live_label" style="@style/HeroLabel" android:text="지금 달리는 경로 · 전비 색" android:drawableStart="@drawable/ic_st_dist" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card">
                    <WebView
                        android:id="@+id/dash_live_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
