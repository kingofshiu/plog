<?xml version="1.0" encoding="utf-8"?>
<!-- 충전 탭 v2 (2026-09-13, 사용자: "요즘 트렌드와 감성" → 주행 탭 문법으로 통일).
     위 = 기간 제목 + 기간 탭(주간/월간/연간/전체) + ◀▶ / "이번 달 한눈에" 히어로 3칸(요금·충전량·kWh당) + 급속/완속 비율 띠
     아래 = 기록 목록(색 점 + 시각 + 한 줄 요약 | 큰 kWh + 요금). 칩·테두리 없음, 헤어라인만 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/charges_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/charges_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_label"
            android:textColor="#8E8E93"
            android:layout_marginStart="18dp"
            android:paddingTop="6dp" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <!-- 기간 탭 (2026-09-13, 사용자: "주간·연간도 보게") — 주행 기록 화면과 같은 모양 -->
        <LinearLayout
            android:id="@+id/charges_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="24dp">
            <TextView style="@style/PeriodTab" android:text="주간" />
            <TextView style="@style/PeriodTab" android:text="월간" />
            <TextView style="@style/PeriodTab" android:text="연간" />
            <TextView style="@style/PeriodTab" android:text="전체" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/charges_prev"
            style="@style/MonthNavButton"
            android:layout_width="72dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="이전 달" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <ImageButton
            android:id="@+id/charges_next"
            style="@style/MonthNavButton"
            android:layout_width="72dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="다음 달" />
    </LinearLayout>

    <!-- 이번 달 한눈에 -->
    <LinearLayout
        android:id="@+id/charges_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="16dp">
        <LinearLayout style="@style/TdCell">
            <TextView style="@style/HeroLabel" android:text="충전 요금" android:drawableStart="@drawable/ic_st_won" />
            <TextView android:id="@+id/charges_cost" style="@style/SumValue" android:textSize="@dimen/text_value_l" android:textColor="@color/accent" />
        </LinearLayout>
        <LinearLayout style="@style/TdCell">
            <TextView style="@style/HeroLabel" android:text="충전량" android:drawableStart="@drawable/ic_st_energy" />
            <TextView android:id="@+id/charges_kwh" style="@style/SumValue" android:textSize="@dimen/text_value_l" />
        </LinearLayout>
        <LinearLayout style="@style/TdCell">
            <TextView style="@style/HeroLabel" android:text="kWh당" android:drawableStart="@drawable/ic_st_station" />
            <TextView android:id="@+id/charges_unit" style="@style/SumValue" android:textSize="@dimen/text_value_l" />
        </LinearLayout>
    </LinearLayout>

    <!-- 급속/완속 비율 띠 -->
    <LinearLayout
        android:id="@+id/charges_split"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">
        <View android:id="@+id/charges_split_dc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/accent" />
        <View android:layout_width="3dp" android:layout_height="match_parent" android:background="@color/bg" />
        <View android:id="@+id/charges_split_ac" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/blue" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/charges_split_dc_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_label"
            android:textColor="@color/accent" />
        <TextView
            android:id="@+id/charges_split_ac_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="@dimen/text_label"
            android:textColor="@color/blue" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#232326"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/charges_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="64dp"
        android:drawableTop="@drawable/ic_bolt"
        android:drawableTint="#5A5A60"
        android:drawablePadding="16dp"
        android:text="이 기간엔 충전 기록이 없습니다\n충전이 끝나면 여기에 자동으로 쌓입니다"
        android:lineSpacingExtra="6dp"
        android:textSize="@dimen/text_label"
        android:textColor="@color/text_sub"
        android:visibility="gone" />

    <ListView
        android:id="@+id/charges_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never" />
</LinearLayout>
