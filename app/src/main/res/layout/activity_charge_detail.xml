<?xml version="1.0" encoding="utf-8"?>
<!-- 충전 상세 v3 (2026-09-08, 사용자): 라벨 아이콘 + 숫자 카운트업 + 충전소 위치 지도(위) + 충전 타임라인 ChargeStripView(아래).
     왼쪽 = 충전량 히어로·통계·단가 수정. Activity/오버레이 공용 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/cd_back"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/text"
            android:scaleX="1.8"
            android:scaleY="1.8"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="뒤로" />
        <TextView
            android:id="@+id/cd_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/cd_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:baselineAligned="false">

        <!-- 좌측: 충전량 히어로 + 통계 -->
        <LinearLayout
            android:id="@+id/cd_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="30dp">

            <TextView
                style="@style/TdLabel"
                android:text="충전량"
                android:drawableStart="@drawable/ic_st_energy" />
            <TextView
                android:id="@+id/cd_kwh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_value_xl"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/cd_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_value_m"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/accent"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="시간" android:drawableStart="@drawable/ic_st_time" />
                    <TextView android:id="@+id/cd_time" style="@style/TdValue" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="배터리" android:drawableStart="@drawable/ic_st_battery" />
                    <TextView android:id="@+id/cd_soc" style="@style/TdValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="단가" android:drawableStart="@drawable/ic_st_won" />
                    <TextView android:id="@+id/cd_rate" style="@style/TdValue" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView android:id="@+id/cd_station_label" style="@style/TdLabel" android:text="충전소" android:drawableStart="@drawable/ic_st_station" />
                    <TextView android:id="@+id/cd_station" style="@style/TdValue"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- 내 충전기(집·회사)일 때: 계량 kWh · 시간대 구성 (2026-09-24) -->
            <TextView
                android:id="@+id/cd_kind_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_sub"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- 충전소 선택 패널 (2026-09-22): 지도 마커를 고르면 대화상자 대신 여기에 앱 문법으로 표시 —
                 이름·사업자·정격 / 공식 요금표 단가(큰 숫자, 바로 고칠 수 있는 입력) / 5구간 한 줄 / 상태 문구 / 저장·보조 버튼 -->
            <LinearLayout
                android:id="@+id/cd_pick_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp"
                android:visibility="gone">
                <TextView style="@style/TdLabel" android:text="선택한 충전소" android:drawableStart="@drawable/ic_st_station" />
                <TextView
                    android:id="@+id/cd_pk_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_title"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/cd_pk_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#232326" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" />
                <TextView android:id="@+id/cd_pk_fee_label" style="@style/TdLabel" android:text="공식 요금표" android:drawableStart="@drawable/ic_st_won" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="2dp">
                    <EditText
                        android:id="@+id/cd_pk_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:background="@null"
                        android:padding="0dp"
                        android:inputType="numberDecimal"
                        android:textSize="@dimen/text_value_l"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/accent"
                        android:includeFontPadding="false"
                        android:imeOptions="actionDone" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="원/kWh"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif-light"
                        android:textColor="#8E8E93"
                        android:includeFontPadding="false"
                        android:paddingBottom="6dp"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/cd_pk_bands"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_small"
                        android:textColor="#8E8E93"
                        android:includeFontPadding="false"
                        android:paddingBottom="7dp"
                        android:layout_marginStart="22dp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
                <TextView
                    android:id="@+id/cd_pk_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/cd_pk_save"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_label"
                    android:fontFamily="sans-serif-medium"
                    android:text="이 단가로 저장" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button android:id="@+id/cd_pk_web" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                        android:background="@drawable/bg_button_dim" android:textColor="@color/text" android:textSize="@dimen/text_label" android:fontFamily="sans-serif-medium" android:text="요금표 웹" />
                    <Button android:id="@+id/cd_pk_naver" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="12dp"
                        android:background="@drawable/bg_button_dim" android:textColor="@color/text" android:textSize="@dimen/text_label" android:fontFamily="sans-serif-medium" android:text="네이버 지도" />
                    <Button android:id="@+id/cd_pk_cancel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="12dp"
                        android:background="@drawable/bg_button_dim" android:textColor="@color/text" android:textSize="@dimen/text_label" android:fontFamily="sans-serif-medium" android:text="닫기" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/cd_pick_station"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_button_dim"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:fontFamily="sans-serif-medium"
                android:text="충전소 직접 선택 (지도에서 누르기)" />
            <Button
                android:id="@+id/cd_edit_rate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_dim"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:fontFamily="sans-serif-medium"
                android:text="단가 수정 (실제 결제 금액으로)" />
            <!-- 내 충전기 등록 (2026-09-24): 이 자리를 집/회사로 기억 → 위치만으로 인식, 요금은 정액 또는 한전 시간대 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <Button android:id="@+id/cd_set_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                    android:background="@drawable/bg_button_dim" android:textColor="@color/text" android:textSize="@dimen/text_label" android:fontFamily="sans-serif-medium"
                    android:drawableStart="@drawable/ic_st_home" android:drawablePadding="10dp" android:drawableTint="@color/text" android:paddingStart="22dp" android:paddingEnd="22dp"
                    android:text="이 자리를 집으로" />
                <Button android:id="@+id/cd_set_work" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="12dp"
                    android:background="@drawable/bg_button_dim" android:textColor="@color/text" android:textSize="@dimen/text_label" android:fontFamily="sans-serif-medium"
                    android:drawableStart="@drawable/ic_st_work" android:drawablePadding="10dp" android:drawableTint="@color/text" android:paddingStart="22dp" android:paddingEnd="22dp"
                    android:text="이 자리를 회사로" />
            </LinearLayout>
        </LinearLayout>

        <!-- 우측 (v3, 사용자 2026-09-08): 위 충전소 위치 지도, 아래 충전 타임라인(ChargeStripView) -->
        <LinearLayout
            android:id="@+id/cd_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/cd_map_label"
                style="@style/TdLabel"
                android:text="충전소 위치"
                android:drawableStart="@drawable/ic_st_station" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card">
                <WebView
                    android:id="@+id/cd_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/cd_map_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="이 충전의 위치 정보가 없습니다"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_sub"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/cd_chart_label"
                style="@style/TdLabel"
                android:text="충전 타임라인 · 진할수록 빠르게"
                android:drawableStart="@drawable/ic_st_speed"
                android:layout_marginTop="18dp" />
            <com.p4log.car.ChargeStripView
                android:id="@+id/cd_chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.85"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
