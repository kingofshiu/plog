<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp">
        <TextView
            android:id="@+id/cd_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="24sp"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/cd_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/cd_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:baselineAligned="false">

        <!-- 좌측: 충전량 히어로 + 통계 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="충전량"
                android:textSize="18sp"
                android:letterSpacing="0.25"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/cd_kwh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="68sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/cd_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/accent"
                android:includeFontPadding="false"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="시간" />
                    <TextView android:id="@+id/cd_time" style="@style/TdValue"
                        android:textSize="27sp" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="배터리" />
                    <TextView android:id="@+id/cd_soc" style="@style/TdValue"
                        android:textSize="27sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="단가" />
                    <TextView android:id="@+id/cd_rate" style="@style/TdValue"
                        android:textSize="27sp" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="충전소" />
                    <TextView android:id="@+id/cd_station" style="@style/TdValue"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/cd_edit_rate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_dim"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:text="단가 수정 (실제 결제 금액으로)" />
        </LinearLayout>

        <!-- 우측: 충전 속도 프로파일 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="충전 속도 프로파일"
                android:textSize="18sp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_sub" />

            <com.p4log.car.ChargeProfileChartView
                android:id="@+id/cd_chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
