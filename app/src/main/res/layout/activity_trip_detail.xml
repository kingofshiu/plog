<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">
        <!-- 뒤로가기 (2026-09-08 사용자: 더 크게) — 72dp 터치 영역, 셰브론 1.8배, 눌림 효과 -->
        <ImageView
            android:id="@+id/td_back"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/text"
            android:scaleX="1.8"
            android:scaleY="1.8"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="뒤로" />
        <TextView
            android:id="@+id/td_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:baselineAligned="false">

        <!-- 좌측: 통계가 주인공 (2열 그리드) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="거리"
                android:drawableStart="@drawable/ic_st_dist"
                android:drawablePadding="10dp"
                android:drawableTint="#C9C9CE"
                android:gravity="center_vertical"
                android:textSize="@dimen/text_body"
                android:letterSpacing="0.25"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/td_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_value_xl"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="22dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="시간" android:drawableStart="@drawable/ic_st_time" />
                    <TextView android:id="@+id/td_time" style="@style/TdValue" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="전비" android:drawableStart="@drawable/ic_st_eff" />
                    <TextView android:id="@+id/td_eff" style="@style/TdValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="사용 전력" android:drawableStart="@drawable/ic_st_energy" />
                    <TextView android:id="@+id/td_energy" style="@style/TdValue" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="배터리" android:drawableStart="@drawable/ic_st_battery" />
                    <TextView android:id="@+id/td_soc" style="@style/TdValue"
                        android:textSize="@dimen/text_title" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:baselineAligned="false">
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="평균 속도" android:drawableStart="@drawable/ic_st_speed_avg" />
                    <TextView android:id="@+id/td_speed_avg" style="@style/TdValue" />
                </LinearLayout>
                <LinearLayout style="@style/TdCell">
                    <TextView style="@style/TdLabel" android:text="최고 속도" android:drawableStart="@drawable/ic_st_speed_max" />
                    <TextView android:id="@+id/td_speed_max" style="@style/TdValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 우측: 작은 지도 + 전비 비교 그래프 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 지도와 그래프를 같은 크기(1:1)로 고정 분배 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card">
                <WebView
                    android:id="@+id/td_web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전비 비교 — 최근 주행 vs 이번 주행"
                android:textSize="@dimen/text_label"
                android:letterSpacing="0.1"
                android:textColor="@color/text_sub"
                android:layout_marginTop="14dp" />

            <com.p4log.car.TripEffChartView
                android:id="@+id/td_chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
