<?xml version="1.0" encoding="utf-8"?>
<!-- 소모품 한 줄 v2 (2026-09-13): 칩 대신 색 글자 상태, 진행 막대 색 단계(여유 흰색 → 곧 교체 주황 → 교체 필요 빨강), 큰 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/rcons_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text" />
                <TextView
                    android:id="@+id/rcons_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_label"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rcons_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_sub"
                android:layout_marginTop="6dp" />

            <ProgressBar
                android:id="@+id/rcons_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:progressDrawable="@drawable/pb_soc" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/rcons_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_value_m"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:includeFontPadding="false"
                android:minWidth="200dp"
                android:gravity="end" />
            <Button
                android:id="@+id/rcons_replace"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_dim"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:layout_marginStart="28dp"
                android:text="교체함" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_line" />
</LinearLayout>
