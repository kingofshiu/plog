<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 탭 v2 (2026-09-13): 섹션 제목에 아이콘, 키는 가려두고 [보기]로 펼침, 버튼 높이 통일 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- 왼쪽: 차량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="44dp">

                <TextView style="@style/HeroLabel" android:text="차량" android:drawableStart="@drawable/ic_tab_car" />

                <TextView style="@style/SetLabel" android:text="배터리 용량 (kWh)" />
                <EditText android:id="@+id/set_capacity" style="@style/SetEdit"
                    android:inputType="numberDecimal" />

                <TextView style="@style/SetLabel"
                    android:text="현재 누적 주행거리 (km) — 계기판 값 입력" />
                <EditText android:id="@+id/set_odo" style="@style/SetEdit"
                    android:inputType="number" />

                <!-- 지도·충전소 API 키 (2026-09-15): 공개 릴리즈 APK는 키가 비어 있어 여기서 넣는다 -->
                <TextView style="@style/HeroLabel" android:text="API 키" android:drawableStart="@drawable/ic_st_station" android:layout_marginTop="28dp" />
                <TextView style="@style/SetLabel" android:text="VWorld 지도 인증키 (vworld.kr) — 지도·동네 이름" />
                <EditText android:id="@+id/set_vworld" style="@style/SetEdit"
                    android:inputType="text" />
                <TextView style="@style/SetLabel" android:text="충전소 정보 API 키 (data.go.kr, 일반 인증키 Encoding)" />
                <EditText android:id="@+id/set_datago" style="@style/SetEdit"
                    android:inputType="text" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_small"
                    android:textColor="@color/text_sub"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="16dp"
                    android:text="충전 요금은 충전소 자동 인식으로 계산됩니다.\n충전 기록을 누르면 단가를 수정할 수 있고, 수정한 단가는 그 충전소에 기억됩니다." />
            </LinearLayout>

            <!-- 오른쪽: 웹 연동 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/HeroLabel" android:text="웹 로그 연동 (Supabase)" android:drawableStart="@drawable/ic_st_log" />

                <TextView style="@style/SetLabel" android:text="Project URL (https://xxxx.supabase.co)" />
                <EditText android:id="@+id/set_sb_url" style="@style/SetEdit"
                    android:inputType="textUri" />

                <TextView style="@style/SetLabel" android:text="anon public 키" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText android:id="@+id/set_sb_key" style="@style/SetEdit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:inputType="textPassword" />
                    <TextView
                        android:id="@+id/set_sb_key_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="보기"
                        android:textSize="@dimen/text_label"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:background="@drawable/bg_button_dim"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView style="@style/SetLabel" android:text="차량 ID (웹에서 같은 값 입력)" />
                <EditText android:id="@+id/set_device_id" style="@style/SetEdit"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <Button
                        android:id="@+id/set_test"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_dim"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/text"
                        android:text="연결 테스트"
                        android:layout_marginEnd="10dp" />
                    <Button
                        android:id="@+id/set_sync_now"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="@dimen/text_label"
                        android:textColor="#FFFFFF"
                        android:text="지금 올리기" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_sync_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="12dp" />
                <!-- 서버 사용량 / 무료 한도 (2026-09-21, 사용자: "글자만으론 판단이 어렵다" → 막대): 탭을 열 때와 [연결 테스트] 때 갱신 -->
                <TextView style="@style/HeroLabel" android:text="서버 사용량 · 무료 한도" android:drawableStart="@drawable/ic_st_server" android:layout_marginTop="22dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView style="@style/HdLabel" android:text="데이터베이스" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/set_usage_db" style="@style/HdValue" android:text="확인 중…" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/set_usage_db_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/pb_soc" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <TextView style="@style/HdLabel" android:text="사진·로그 저장소" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/set_usage_st" style="@style/HdValue" android:text="확인 중…" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/set_usage_st_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/pb_soc" />
                <TextView
                    android:id="@+id/set_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_small"
                    android:textColor="#8E8E93"
                    android:layout_marginTop="10dp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="22dp">
            <Button
                android:id="@+id/set_save"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_label"
                android:text="설정 저장"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/set_diag"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dim"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:text="차량 데이터 진단" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
