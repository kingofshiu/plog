<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- 왼쪽: 차량/요금 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="차량"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text" />

                <TextView style="@style/SetLabel" android:text="배터리 용량 (kWh)" />
                <EditText android:id="@+id/set_capacity" style="@style/SetEdit"
                    android:inputType="numberDecimal" />

                <TextView style="@style/SetLabel"
                    android:text="현재 누적 주행거리 (km) — 계기판 값 입력" />
                <EditText android:id="@+id/set_odo" style="@style/SetEdit"
                    android:inputType="number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="14dp"
                    android:text="충전 요금은 충전소 자동 인식으로 계산됩니다.\n충전 탭에서 기록을 누르면 단가를 수정할 수 있고,\n수정한 단가는 그 충전소에 기억됩니다." />
            </LinearLayout>

            <!-- 오른쪽: 웹 연동 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="웹 로그 연동 (Supabase)"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text" />

                <TextView style="@style/SetLabel" android:text="Project URL (https://xxxx.supabase.co)" />
                <EditText android:id="@+id/set_sb_url" style="@style/SetEdit"
                    android:inputType="textUri" />

                <TextView style="@style/SetLabel" android:text="anon public 키" />
                <EditText android:id="@+id/set_sb_key" style="@style/SetEdit"
                    android:inputType="text" />

                <TextView style="@style/SetLabel" android:text="차량 ID (웹에서 같은 값 입력)" />
                <EditText android:id="@+id/set_device_id" style="@style/SetEdit"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <Button
                        android:id="@+id/set_test"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_dim"
                        android:textColor="@color/text"
                        android:text="연결 테스트"
                        android:layout_marginEnd="8dp" />
                    <Button
                        android:id="@+id/set_sync_now"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:textColor="#FFFFFF"
                        android:text="지금 올리기" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_sync_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/set_save"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:text="설정 저장"
                android:layout_marginEnd="8dp" />
            <Button
                android:id="@+id/set_diag"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dim"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:text="차량 데이터 진단" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
