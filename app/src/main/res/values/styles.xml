<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.P4Log" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 주차 사진 액티비티: 투명 창. 뒤 화면을 가리지 않고 구석에 카드만 보인다 (2026-09-03) -->
    <style name="Theme.P4Log.Photo" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 주행 상세 통계 그리드 셀 -->
    <style name="TdCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TdLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">#C9C9CE</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TdValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_value_m</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:text">-</item>
    </style>

    <!-- 목록 상단 월 이동 버튼 (ImageButton, ◀▶ 텍스트는 차량 폰트에서 빈 네모로 나와 아이콘으로 교체) -->
    <style name="MonthNavButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button_dim</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
    </style>

    <!-- 설정 입력 라벨/필드 -->
    <style name="SetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SetEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">#C9C9CE</item>
        <item name="android:backgroundTint">@color/card_line</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <!-- 주행 기록 화면 (2026-09-06): 기간 탭 + 요약 셀 -->
    <style name="PeriodTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>
    <style name="SumLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">#8E8E93</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="SumValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_value_m</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:text">-</item>
    </style>

    <!-- 주행 기록 화면 오른쪽 상세 정보 칸 (요약보다 크게) -->
    <style name="DetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">#C9C9CE</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="DetValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_value_m</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:text">-</item>
    </style>

    <!-- 주행 탭 v8 (2026-09-06): 박스 없는 타이포 레이아웃용 -->
    <!-- 헤더 한 줄의 라벨/값 (오늘 주행 · 오늘 전비 · 누적, 주행가능거리) -->
    <style name="HdLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="HdValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:text">-</item>
    </style>
    <!-- 히어로 숫자: 작은 대문자 라벨 위, 가는 큰 숫자 아래 (단위는 코드에서 작은 회색 span) -->
    <style name="HeroLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">#8E8E93</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="HeroValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_value_xl</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:text">-</item>
    </style>
</resources>
